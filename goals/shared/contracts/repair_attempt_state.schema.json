{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/repair_attempt_state.schema.json",
  "title": "repair_attempt_state",
  "description": "Repair attempt/revision/progress lineage and limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repair_attempt_id",
    "run_id",
    "stage_id",
    "failure_id",
    "attempt_number",
    "status",
    "workspace_fingerprint"
  ],
  "properties": {
    "repair_attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "failure_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "revision_number": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "status": {
      "enum": [
        "evidence_building",
        "proposer_running",
        "reviewer_running",
        "revision_required",
        "waiting_human_apply",
        "applying",
        "preflight",
        "validating",
        "succeeded",
        "failed",
        "attempt_limit_reached"
      ]
    },
    "workspace_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "failure_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proposal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "no_progress_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
