{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/sealed_stage_output.schema.json",
  "title": "sealed_stage_output",
  "description": "Clean approved stage output and copy-forward boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "stage_id",
    "output_fingerprint",
    "g12_approval_id",
    "next_stage_input_status",
    "artifact_index"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "output_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "g12_approval_id": {
      "type": "string",
      "minLength": 1
    },
    "next_stage_input_status": {
      "enum": [
        "ready",
        "final_stage",
        "blocked"
      ]
    },
    "next_stage_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_index": {
      "type": "array",
      "items": {
        "$ref": "artifact_ref.schema.json"
      }
    }
  }
}
