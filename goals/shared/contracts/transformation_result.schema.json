{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/transformation_result.schema.json",
  "title": "transformation_result",
  "description": "Exact Angular update result and human-reviewed transformation lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "stage_id",
    "execution_id",
    "target_version",
    "diff_checksum",
    "changed_files",
    "risk_level",
    "g08_status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "diff_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "blocked"
      ]
    },
    "g08_status": {
      "enum": [
        "pending",
        "approved",
        "approved_with_comment",
        "modification_requested",
        "rejected",
        "stale"
      ]
    },
    "diff_artifact": {
      "$ref": "artifact_ref.schema.json"
    },
    "workspace_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
