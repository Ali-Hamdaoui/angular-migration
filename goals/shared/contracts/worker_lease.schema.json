{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/worker_lease.schema.json",
  "title": "worker_lease",
  "description": "Authoritative command/job ownership lease.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_id",
    "run_id",
    "worker_id",
    "backend_instance_id",
    "status",
    "heartbeat_at",
    "expires_at"
  ],
  "properties": {
    "lease_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "backend_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "released",
        "expired",
        "interrupted"
      ]
    },
    "heartbeat_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    }
  }
}
