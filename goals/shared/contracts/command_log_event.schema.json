{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/command_log_event.schema.json",
  "title": "command_log_event",
  "description": "Ordered persisted/replayable command log chunk.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "sequence",
    "stream",
    "text",
    "created_at"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "stream": {
      "enum": [
        "stdout",
        "stderr",
        "system"
      ]
    },
    "text": {
      "type": "string"
    },
    "redacted": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
