# Copy to backend/.env for local-only overrides. Never commit backend/.env.
APP_ENV=development
APPLICATION_DATA_ROOT=C:\Users\<user>\AppData\Local\AngularMigrationControlTower
# Leave DATABASE_URL unset to use APPLICATION_DATA_ROOT/control-tower.db.
DATABASE_URL=
ALLOWED_SOURCE_ROOTS=C:\client-projects,/opt/client-projects
ALLOWED_TARGET_ROOTS=C:\Users\abdelilah.mortaki\Desktop\angularRus
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3301,http://127.0.0.1:3301
COMMAND_TIMEOUT_SECONDS=300
COMMAND_MAX_OUTPUT_BYTES=1000000
WORKER_LEASE_SECONDS=120
SSE_HEARTBEAT_SECONDS=15
SSE_REPLAY_RETENTION_EVENTS=1000
LOG_CHUNK_BYTES=64000
SQLITE_WAL_ENABLED=true
SQLITE_BUSY_TIMEOUT_MS=5000
LLM_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
LLM_INPUT_PRICE_PER_MILLION_TOKENS=0
LLM_OUTPUT_PRICE_PER_MILLION_TOKENS=0
LLM_TOKEN_BUDGET=0
LLM_COST_BUDGET_USD=0
