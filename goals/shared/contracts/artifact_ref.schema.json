{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/artifact_ref.schema.json",
  "title": "artifact_ref",
  "description": "Immutable registered evidence reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "content_hash",
    "uri"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
