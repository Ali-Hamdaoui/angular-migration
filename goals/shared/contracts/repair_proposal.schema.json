{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/repair_proposal.schema.json",
  "title": "repair_proposal",
  "description": "Only Repair Proposer authors this candidate diff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "failure_id",
    "context_pack_id",
    "proposer_invocation_id",
    "status",
    "diff_checksum",
    "changed_files",
    "workspace_fingerprint"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "failure_id": {
      "type": "string",
      "minLength": 1
    },
    "context_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "proposer_invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "insufficient_context",
        "not_repairable"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "root_cause": {
      "type": "string",
      "minLength": 1
    },
    "fix_strategy": {
      "type": "string",
      "minLength": 1
    },
    "diff_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "diff_artifact": {
      "$ref": "artifact_ref.schema.json"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workspace_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
