{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amfa.nousresearch.com/contracts/stage_validation_summary.schema.json",
  "title": "StageValidationSummary",
  "description": "Aggregated validation summary for a single migration stage across all S3-F10/F11/F12/F13 results.",
  "type": "object",
  "properties": {
    "run_id": {"type": "string", "description": "Migration run identifier"},
    "stage_id": {"type": "string", "description": "Stage identifier"},
    "validation_status": {"type": ["string", "null"], "description": "Status of final install + static checks (S3-F10)"},
    "build_status": {"type": ["string", "null"], "description": "Status of build matrix (S3-F11)"},
    "test_status": {"type": ["string", "null"], "description": "Status of test suite (S3-F12)"},
    "lint_status": {"type": ["string", "null"], "description": "Status of lint checks (S3-F12)"},
    "assurance_status": {"type": ["string", "null"], "description": "Status of parity comparison / assurance (S3-F13)"},
    "aggregate_status": {
      "type": "string",
      "enum": ["not_started", "running", "passed", "failed", "blocked", "completed"],
      "description": "Aggregated status across all validation dimensions"
    },
    "artifact_ids": {
      "type": "array",
      "items": {"type": "string"},
      "description": "All artifact IDs produced across validation"
    },
    "state_version": {"type": "integer", "description": "Optimistic concurrency version"},
    "event_sequence": {"type": "integer", "description": "Last workflow event sequence number"}
  },
  "required": ["run_id", "stage_id", "aggregate_status", "state_version", "event_sequence"]
}
