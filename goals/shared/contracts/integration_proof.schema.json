{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/integration_proof.schema.json",
  "title": "integration_proof",
  "description": "Integrated Goal 10 Phase B acceptance evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proof_id",
    "integration_commit_sha",
    "goal_commits",
    "sprint2_commits",
    "scenarios",
    "jira_complete",
    "created_at"
  ],
  "properties": {
    "proof_id": {
      "type": "string",
      "minLength": 1
    },
    "integration_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "goal_commits": {
      "type": "object",
      "minProperties": 9,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{7,40}$"
      }
    },
    "sprint2_commits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{7,40}$"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "verdict",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "artifact_ref.schema.json"
            }
          }
        }
      }
    },
    "jira_complete": {
      "const": true
    },
    "human_product_signoff": {
      "enum": [
        "approved"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
