{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/failure_evidence.schema.json",
  "title": "failure_evidence",
  "description": "Immutable deterministic evidence from a real failed command.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "failure_id",
    "run_id",
    "stage_id",
    "execution_id",
    "failure_fingerprint",
    "origin",
    "diagnostics",
    "workspace_fingerprint",
    "status"
  ],
  "properties": {
    "failure_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "failure_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "origin": {
      "enum": [
        "pre_existing_unchanged",
        "pre_existing_changed",
        "migration_caused",
        "resolved_pre_existing",
        "unknown_origin"
      ]
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "workspace_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "finalized",
        "invalid",
        "stale"
      ]
    },
    "raw_log_artifacts": {
      "type": "array",
      "items": {
        "$ref": "artifact_ref.schema.json"
      }
    }
  }
}
