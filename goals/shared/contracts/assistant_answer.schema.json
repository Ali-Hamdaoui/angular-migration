{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/assistant_answer.schema.json",
  "title": "assistant_answer",
  "description": "Evidence-grounded read-only assistant answer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "run_id",
    "question",
    "answer",
    "proof_labels",
    "evidence_refs",
    "read_only"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "proof_labels": {
      "type": "array",
      "items": {
        "enum": [
          "PROVEN",
          "INFERRED",
          "NOT_PROVEN"
        ]
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "artifact_ref.schema.json"
      }
    },
    "read_only": {
      "const": true
    },
    "usage_record_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
