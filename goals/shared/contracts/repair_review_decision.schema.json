{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/repair_review_decision.schema.json",
  "title": "repair_review_decision",
  "description": "Non-authoring reviewer result; schema intentionally contains no diff field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "proposal_id",
    "reviewer_invocation_id",
    "decision",
    "proposal_diff_checksum",
    "review_checksum"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "accept",
        "request_revision",
        "reject",
        "insufficient_context"
      ]
    },
    "proposal_diff_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "review_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "critique": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision_instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
