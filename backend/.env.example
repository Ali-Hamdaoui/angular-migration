# Copy to backend/.env for local-only overrides. Never commit backend/.env.
APP_ENV=development
DATABASE_URL=sqlite:///./.migration-factory/migration-factory.db
ARTIFACT_ROOT=.migration-factory/runs
SANDBOX_ROOT=.migration-factory/sandboxes
BACKEND_CORS_ORIGINS=http://localhost:3000
COMMAND_TIMEOUT_SECONDS=300

# Keep false until AMF-S0-14 implements the gateway. When true, all AZURE_*
# values below are required. Use company-managed secrets; do not place real keys
# in this example file.
LLM_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
