{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/source_integrity_proof.schema.json",
  "title": "source_integrity_proof",
  "description": "Proof that the external source remained unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "source_path_reference",
    "before_fingerprint",
    "after_fingerprint",
    "status",
    "checked_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_path_reference": {
      "type": "string",
      "minLength": 1
    },
    "before_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "after_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "unchanged",
        "changed",
        "unverifiable"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "artifact_ref.schema.json"
      }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
