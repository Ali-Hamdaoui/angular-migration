{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/approved_stage_plan.schema.json",
  "title": "approved_stage_plan",
  "description": "Read-only Sprint 2 handoff required before stage mutation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "stage_id",
    "plan_id",
    "plan_version",
    "plan_checksum",
    "input_fingerprint",
    "source_family",
    "target_family",
    "target_angular_exact",
    "execution_profile_id",
    "command_refs",
    "g06_approval_id"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "plan_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_family": {
      "type": "string",
      "minLength": 1
    },
    "target_family": {
      "type": "string",
      "minLength": 1
    },
    "target_angular_exact": {
      "type": "string",
      "minLength": 1
    },
    "execution_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "command_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "g06_approval_id": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    }
  }
}
