# Copy to backend/.env for local-only overrides. Never commit backend/.env.
APP_ENV=development
DATABASE_URL=sqlite:///./.migration-factory/migration-factory.db
ARTIFACT_ROOT=.migration-factory/runs
WORKSPACE_ROOT=.migration-factory/workspaces
SNAPSHOT_ROOT=.migration-factory/snapshots
DELIVERY_ROOT=.migration-factory/delivery
SANDBOX_ROOT=.migration-factory/sandboxes
ALLOWED_SOURCE_ROOTS=demo-apps,C:\projects\approved-sources,/opt/approved-sources
ALLOWED_TARGET_ROOTS=.migration-factory,C:\tmp\migration-output,/tmp/migration-output
BACKEND_CORS_ORIGINS=http://localhost:3000
COMMAND_TIMEOUT_SECONDS=300
COMMAND_MAX_OUTPUT_BYTES=1000000
WORKER_LEASE_SECONDS=120
SSE_HEARTBEAT_SECONDS=15
SSE_REPLAY_RETENTION_EVENTS=1000
LOG_CHUNK_BYTES=64000
SQLITE_WAL_ENABLED=true
SQLITE_BUSY_TIMEOUT_MS=5000

# Keep false until AMF-S0-14 implements the gateway. When true, all AZURE_*
# values below are required. Use company-managed secrets; do not place real keys
# in this example file.
LLM_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
LLM_INPUT_PRICE_PER_MILLION_TOKENS=0
LLM_OUTPUT_PRICE_PER_MILLION_TOKENS=0
LLM_TOKEN_BUDGET=0
LLM_COST_BUDGET_USD=0
