{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/changed_file_risk_summary.schema.json",
  "title": "changed_file_risk_summary",
  "description": "Content-aware changed-file risk classification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "stage_id",
    "diff_checksum",
    "overall_risk",
    "files"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "diff_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "overall_risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "blocked"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "risk",
          "reasons"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "blocked"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changed_symbols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "requires_strategic_approval": {
      "type": "boolean"
    }
  }
}
