{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/recovery_decision.schema.json",
  "title": "recovery_decision",
  "description": "Deterministic startup/cancellation/crash reconciliation decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "run_id",
    "operation_type",
    "observed_state",
    "action",
    "decision_checksum"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation_type": {
      "type": "string",
      "minLength": 1
    },
    "observed_state": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "resume",
        "rerun",
        "reconstruct",
        "rollback",
        "diagnostic_hold",
        "no_action"
      ]
    },
    "decision_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "artifact_ref.schema.json"
      }
    }
  }
}
