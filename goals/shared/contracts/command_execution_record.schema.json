{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/command_execution_record.schema.json",
  "title": "command_execution_record",
  "description": "Authoritative process execution result and evidence lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "run_id",
    "command_id",
    "authorization_id",
    "status",
    "runtime_checksum",
    "started_at"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "interrupted"
      ]
    },
    "runtime_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "stdout_artifact": {
      "anyOf": [
        {
          "$ref": "artifact_ref.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "stderr_artifact": {
      "anyOf": [
        {
          "$ref": "artifact_ref.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "pre_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "post_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
