{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/patch_apply_ledger.schema.json",
  "title": "patch_apply_ledger",
  "description": "Exact backend patch apply result and fingerprint ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apply_id",
    "proposal_id",
    "diff_checksum",
    "pre_fingerprint",
    "post_fingerprint",
    "status",
    "changed_files"
  ],
  "properties": {
    "apply_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "diff_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pre_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "post_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "applied",
        "rejected_preflight",
        "failed",
        "rolled_back",
        "reconstructed"
      ]
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "artifact_ref.schema.json"
      }
    }
  }
}
