APP_ENV=development
# Application state belongs outside this repository. Per-run data belongs under the user-selected output root.
APPLICATION_DATA_ROOT=C:\Users\<user>\AppData\Local\AngularMigrationControlTower
DATABASE_URL=
ALLOWED_SOURCE_ROOTS=C:\client-projects
ALLOWED_TARGET_ROOTS=C:\migration-results
AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=deployment-placeholder
AZURE_OPENAI_API_VERSION=api-version-placeholder
AZURE_OPENAI_API_KEY=
LLM_ENABLED=false
