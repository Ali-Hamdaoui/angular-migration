{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/repair_g10_package.schema.json",
  "title": "repair_g10_package",
  "description": "Human Apply/Reject package bound to exact proposal/review/evidence lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "review_id",
    "lineage_checksum",
    "diff_checksum",
    "workspace_fingerprint",
    "g10_status"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "lineage_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "diff_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workspace_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "g10_status": {
      "enum": [
        "pending",
        "approved",
        "approved_with_comment",
        "modification_requested",
        "rejected",
        "stale"
      ]
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "artifact_ref.schema.json"
      }
    }
  }
}
