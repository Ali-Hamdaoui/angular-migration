{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/stage_sandbox_ready.schema.json",
  "title": "stage_sandbox_ready",
  "description": "Approved isolated stage workspace boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "stage_id",
    "sandbox_id",
    "workspace_alias",
    "input_fingerprint",
    "plan_checksum",
    "g07_approval_id",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "sandbox_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_alias": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "plan_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "g07_approval_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "blocked",
        "stale"
      ]
    },
    "manifest_artifact": {
      "$ref": "artifact_ref.schema.json"
    }
  }
}
