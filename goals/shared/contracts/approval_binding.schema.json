{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amfa.local/contracts/approval_binding.schema.json",
  "title": "approval_binding",
  "description": "Checksum/state/fingerprint-bound human approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "gate_id",
    "run_id",
    "state_version",
    "artifact_set_checksum",
    "decision",
    "actor",
    "created_at"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "gate_id": {
      "type": "string",
      "pattern": "^G(0[1-9]|1[0-5])$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "artifact_set_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_checksum": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "enum": [
        "approved",
        "approved_with_comment",
        "modification_requested",
        "rejected"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "comment": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "stale": {
      "type": "boolean"
    }
  }
}
